rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isSocietyAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || request.auth.token.role == 'authority');
    }
    
    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isSocietyAdmin();
      allow delete: if isSocietyAdmin();
    }
    
    // Societies & Jurisdictions
    match /societies/{societyId} {
      allow read: if true;
      allow write: if isSocietyAdmin();
    }
    
    // Incidents Collection
    match /incidents/{incidentId} {
      allow read: if true; // Public transparency for community safety map
      allow create: if isAuthenticated();
      // Allow upvoting/verification by authenticated residents, status changes by admins/authorities
      allow update: if isAuthenticated() && (
        // Adding upvote or dispute
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'disputes', 'confirmationsCount', 'disputesCount', 'status', 'timeline', 'updatedAt']) ||
        isSocietyAdmin()
      );
      allow delete: if isSocietyAdmin();
    }
    
    // Community Verification Votes
    match /votes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSocietyAdmin();
    }
    
    // Emergency SOS Beacons
    match /sosAlerts/{sosId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isSocietyAdmin();
    }
    
    // Municipal & Society Announcements
    match /announcements/{annId} {
      allow read: if true;
      allow write: if isSocietyAdmin();
    }
    
    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isSocietyAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
